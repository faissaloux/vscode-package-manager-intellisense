{
  "name": "package-manager-intellisense",
  "displayName": "package-manager-intellisense",
  "version": "1.13.2",
  "description": "Intellisense for package managers files",
  "categories": [
    "Other"
  ],
  "keywords": [
    "bundler",
    "cargo",
    "composer",
    "composer.json",
    "dependency",
    "gemfile",
    "installed package version",
    "manager",
    "npm",
    "package hints",
    "package hints in VS Code",
    "package.json",
    "pnpm",
    "yarn"
  ],
  "homepage": "https://github.com/faissaloux/vscode-package-manager-intellisense/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/faissaloux/vscode-package-manager-intellisense/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Faissal Wahabali"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/faissaloux/vscode-package-manager-intellisense"
  },
  "publisher": "faissaloux",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint:check": "oxlint",
    "lint": "oxlint --fix",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "type:check": "tsc --noEmit",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "@faissaloux/gemfile": "^0.3.0",
    "@iarna/toml": "^2.2.5",
    "@yarnpkg/lockfile": "^1.1.0",
    "axios": "^1.10.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.5",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.78.0",
    "@types/yarnpkg__lockfile": "^1.1.5",
    "@vscode/test-electron": "^2.3.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.50.0",
    "ts-loader": "^9.4.2",
    "typescript": "^5.0.4",
    "webpack": "^5.81.0",
    "webpack-cli": "^5.0.2"
  },
  "contributes": {
    "configuration": [
      {
        "title": "package-manager-intellisense",
        "properties": {
          "package-manager-intellisense.npm.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable npm package manager."
          },
          "package-manager-intellisense.yarn.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable yarn package manager."
          },
          "package-manager-intellisense.pnpm.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable pnpm package manager."
          },
          "package-manager-intellisense.bun.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable bun package manager."
          },
          "package-manager-intellisense.composer.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable composer package manager."
          },
          "package-manager-intellisense.bundler.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable bundler package manager."
          },
          "package-manager-intellisense.cargo.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable cargo package manager."
          },
          "package-manager-intellisense.poetry.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable poetry package manager."
          },
          "package-manager-intellisense.uv.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable uv package manager."
          },
          "package-manager-intellisense.pub.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable pub package manager."
          }
        }
      }
    ]
  },
  "activationEvents": [
    "onFileSystem:**",
    "onLanguage:json",
    "onLanguage:text",
    "onLanguage:toml",
    "onLanguage:yaml"
  ],
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.78.0"
  }
}
